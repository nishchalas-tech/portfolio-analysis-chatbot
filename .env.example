# Copy this file to .env and fill in your actual API keys

# LLM API Keys (choose ONE)
# Priority order: ANTHROPIC_API_KEY > GROQ_API_KEY > OPENAI_API_KEY > offline mock

# Anthropic Claude (Preferred - claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Groq Llama 3.3 70B (Very fast, free tier available)
GROQ_API_KEY=gsk_your-key-here

# OpenAI GPT-4o
OPENAI_API_KEY=sk-your-key-here

# Vector Embedding Backend
# Options: tfidf (default, offline), openai, finbert
EMBEDDING_BACKEND=tfidf

# (Optional) Financial data APIs
FMP_API_KEY=your-fmp-key-here
